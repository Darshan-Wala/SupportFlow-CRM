# ─── SupportFlow configuration ──────────────────────────────────────────────
# Copy to `.env` for local development. On Vercel/Render, add these as
# Environment Variables in the project settings instead.

# PostgreSQL connection string (Neon recommended — use the *pooled* URL).
# Leave empty locally to use a JSON file store at .data/supportflow.json.
# Tables are created automatically on first request (prefixed with sf_).
DATABASE_URL=

# Secret used to sign login tokens. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google Gemini API key (https://aistudio.google.com/apikey).
# Without it, tickets are triaged by the built-in rule-based classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to "false" to stop public sign-ups (admins can still add team members).
ALLOW_SIGNUP=true

# Only needed when the frontend is hosted on a different domain than the API
# (comma-separated list of origins), e.g. https://supportflow.vercel.app
CORS_ORIGINS=

# Requests per IP per 15 minutes across the API.
RATE_LIMIT_MAX=600

# Local API port (dev server proxies /api to it).
PORT=5000

# ─── Frontend (build-time) ──────────────────────────────────────────────────
# Leave empty when the API is served from the same domain (the Vercel setup).
# Set it only if the API lives elsewhere, e.g. https://supportflow-api.onrender.com/api
VITE_API_URL=
