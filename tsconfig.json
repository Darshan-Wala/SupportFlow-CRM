{
  // Root config. `tsc -b` type-checks the two projects below.
  // The compilerOptions here are also what Vercel uses to compile the /api function.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true
  },
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.server.json" }]
}
